<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Enable hardware acceleration explicitly at the window level -->
        <item name="android:hardwareAccelerated">true</item>
        
        <!-- Immersive edge-to-edge styling -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        
        <!-- Deep pitch-black background to blend seamlessly with the splash screen -->
        <item name="android:windowBackground">@android:color/black</item>
        
        <!-- Modern notch support for full screen layout under notches -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>
</resources>
